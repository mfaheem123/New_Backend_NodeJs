{"duration":104,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      dsh.id,\n      dsh.driver_id,\n\n      dsh.login_date,\n      dsh.login_latitude,\n      dsh.login_longitude,\n\n      dsh.logout_date,\n      dsh.logout_latitude,\n      dsh.logout_longitude,\n\n      dsh.booking,\n\n      dsh.login_time,\n      dsh.logout_time,\n\n      json_build_object(\n        'username',\n        d.username\n      ) AS driver,\n\n      COUNT(*) OVER() AS total_count\n\n    FROM driver_shift_histories dsh\n\n    LEFT JOIN drivers d\n    ON d.id = dsh.driver_id\n\n    WHERE 1=1\n   AND dsh.driver_id = $1  AND dsh.login_date BETWEEN $2 AND $3  AND dsh.login_time BETWEEN $4 AND $5  AND d.username ILIKE $6  AND COALESCE(cardinality(dsh.booking), 0) = $7  AND dsh.login_date ILIKE $8  AND dsh.logout_date ILIKE $9  ORDER BY dsh.id DESC  LIMIT $10 OFFSET $11 ","timestamp":"2026-09-01T13:03:49.688Z"}
