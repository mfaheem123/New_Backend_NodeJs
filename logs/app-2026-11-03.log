ESCE(pickup_time, '00:00:00'))::timestamp > NOW() + INTERVAL '15 minutes' \n                         AND (pickup_date || ' ' || COALESCE(pickup_time, '00:00:00'))::timestamp <= NOW() + INTERVAL '30 minutes' \n                         AND driver_id IS NULL \n                    THEN 1 \n                END) AS j30_jobs\n\n            FROM bookings\n            WHERE trash = false \n              AND hidden = false \n              AND completed = false\n              AND driver_id IS NULL\n              AND company_id = $1\n            GROUP BY pickup_plot\n        ) j ON z.id = j.zone_id\n\n        -- WHERE clause sabse akhir mein aayega\n        WHERE z.company_id = $1;\n    ","timestamp":"2026-11-03T12:45:27.923Z"}
