{"duration":98,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT COUNT(*) AS total\n    FROM drivers d\n    LEFT JOIN subsidiaries s ON s.id = d.subsidiary_id\n    LEFT JOIN vehicles v ON v.id = d.vehicle_id\n    LEFT JOIN vehicle_types vt_v ON vt_v.id = v.vehicle_type_id\n    LEFT JOIN company_vehicles cv ON cv.id = d.company_vehicle_id\n    LEFT JOIN vehicle_types vt_cv ON vt_cv.id = cv.vehicle_type_id\n    WHERE d.active = $1;\n  ","timestamp":"2026-04-25T09:19:44.084Z"}
{"duration":8,"level":"info","message":"db-query","rows":8,"text":"\n      SELECT\n        bt.id,\n        bt.booking_tabs,\n        CASE bt.id\n          WHEN 1 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) = CURRENT_DATE \n            AND booking_status_id = 1 AND trash = false\n          )\n          WHEN 2 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) > CURRENT_DATE AND trash = false\n          )\n          WHEN 3 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id != 11 AND booking_status_id != 1 AND trash = false\n          )\n          WHEN 4 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id = 11 AND trash = false\n          )\n          WHEN 5 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE quoted = true AND trash = false\n          )\n          WHEN 6 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'ivr' AND trash = false\n          )\n          WHEN 7 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'web' AND trash = false\n          )\n          WHEN 8 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'app' AND trash = false\n          )\n        END::int AS booking_count\n      FROM booking_tabs bt\n      ORDER BY bt.id ASC\n    ","timestamp":"2026-04-25T09:19:44.085Z"}
