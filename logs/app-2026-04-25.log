{"duration":6,"level":"info","message":"db-query","rows":1,"text":"\n        SELECT \n          d.id,\n          d.name AS username,\n          d.username AS name,\n          d.zone,\n          d.last_login_at,\n          \n          -- vehicle type name (dynamic)\n          CASE \n            WHEN d.use_company_vehicle = true THEN vt_cv.name\n            ELSE vt_v.name\n          END AS vehicle_type\n    \n        FROM drivers d\n    \n        -- company vehicle\n        LEFT JOIN company_vehicles cv \n          ON cv.id = d.company_vehicle_id\n    \n        LEFT JOIN vehicle_types vt_cv \n          ON vt_cv.id = cv.vehicle_type_id\n    \n        -- personal vehicle\n        LEFT JOIN vehicles v \n          ON v.id = d.vehicle_id\n    \n        LEFT JOIN vehicle_types vt_v \n          ON vt_v.id = v.vehicle_type_id\n    \n        WHERE \n          d.session_status = 'logged_in'\n          AND d.driver_status = 'Available'\n          AND d.booking_status = 'Available'\n      ","timestamp":"2026-04-25T08:05:32.892Z"}
{"duration":6,"level":"info","message":"db-query","rows":8,"text":"\n      SELECT\n        bt.id,\n        bt.booking_tabs,\n        CASE bt.id\n          WHEN 1 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) = CURRENT_DATE \n            AND booking_status_id = 1 AND trash = false\n          )\n          WHEN 2 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) > CURRENT_DATE AND trash = false\n          )\n          WHEN 3 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id != 11 AND booking_status_id != 1 AND trash = false\n          )\n          WHEN 4 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id = 11 AND trash = false\n          )\n          WHEN 5 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE quoted = true AND trash = false\n          )\n          WHEN 6 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'ivr' AND trash = false\n          )\n          WHEN 7 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'web' AND trash = false\n          )\n          WHEN 8 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'app' AND trash = false\n          )\n        END::int AS booking_count\n      FROM booking_tabs bt\n      ORDER BY bt.id ASC\n    ","timestamp":"2026-04-25T08:05:32.899Z"}
{"duration":2,"level":"info","message":"db-query","rows":6,"text":"SELECT \n      f.*, \n      vt.name AS vehicle_type_name, \n      vt.minimum_fares AS vehicle_minimum_fare\n        FROM fare_configurations f\n          LEFT JOIN vehicle_types vt ON vt.id = f.vehicle_type_id\n        ORDER BY id ASC","timestamp":"2026-04-25T08:05:32.902Z"}
{"duration":87,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.zone,\n      d.latitude,\n      d.longitude,\n      d.booking_status,\n      d.session_status,\n      d.driver_status,\n      d.last_login_at,\n      \n      -- vehicle type name (dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN vt_cv.name\n        ELSE vt_v.name\n      END AS vehicle_type\n\n    FROM drivers d\n\n    -- company vehicle\n    LEFT JOIN company_vehicles cv \n      ON cv.id = d.company_vehicle_id\n\n    LEFT JOIN vehicle_types vt_cv \n      ON vt_cv.id = cv.vehicle_type_id\n\n    -- personal vehicle\n    LEFT JOIN vehicles v \n      ON v.id = d.vehicle_id\n\n    LEFT JOIN vehicle_types vt_v \n      ON vt_v.id = v.vehicle_type_id\n\n    WHERE \n      d.session_status = 'logged_in'\n      AND d.driver_status = 'Available'\n      AND d.booking_status = 'Available'\n  ","timestamp":"2026-04-25T08:05:32.903Z"}
{"duration":1,"level":"info","message":"db-query","rows":2,"text":"\n    SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.zone,\n      d.latitude,\n      d.longitude,\n      d.booking_status,\n      d.session_status,\n      d.driver_status,\n      d.last_login_at,\n      \n      -- vehicle type name (dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN vt_cv.name\n        ELSE vt_v.name\n      END AS vehicle_type\n\n    FROM drivers d\n\n    -- company vehicle\n    LEFT JOIN company_vehicles cv \n      ON cv.id = d.company_vehicle_id\n\n    LEFT JOIN vehicle_types vt_cv \n      ON vt_cv.id = cv.vehicle_type_id\n\n    -- personal vehicle\n    LEFT JOIN vehicles v \n      ON v.id = d.vehicle_id\n\n    LEFT JOIN vehicle_types vt_v \n      ON vt_v.id = v.vehicle_type_id\n\n    WHERE \n      d.session_status = 'logged_in'\n      AND d.driver_status = 'Unavailable'\n      AND d.booking_status IS DISTINCT FROM 'Available'\n  ","timestamp":"2026-04-25T08:05:32.905Z"}
