' || ld.name || '%'\nLEFT JOIN location_types ltp ON lp.location_type_id = ltp.id\nLEFT JOIN location_types ltd ON ld.location_type_id = ltd.id\n\n\n\n    WHERE b.subsidiary_id = $1 AND b.account_id = $2 AND b.booking_status_id = 11 AND b.invoice_number IS NULL AND b.pickup_date::date BETWEEN $3 AND $4 AND b.department = $5\n    ORDER BY b.pickup_date ASC, b.pickup_time ASC\n  ","timestamp":"2026-02-26T03:05:29.624Z"}
