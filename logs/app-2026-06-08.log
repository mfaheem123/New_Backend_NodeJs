{"duration":48,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n\n      COUNT(*) AS total_trips,\n\n      COALESCE(\n        SUM(b.total_charges),\n        0\n      ) AS total_earnings,\n\n      COALESCE(\n        AVG(b.total_charges),\n        0\n      ) AS average_per_trip,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.payment_type_id = 1\n            THEN b.total_charges\n            ELSE 0\n          END\n        ),\n        0\n      ) AS cash_collected\n\n    FROM bookings b\n\n    \n    WHERE b.trash = false\n    AND b.booking_status_id = 11\n   AND b.driver_id = $1\n      AND b.pickup_date::date = $2::date\n    \n  ","timestamp":"2026-06-08T06:12:06.732Z"}
{"duration":1,"level":"info","message":"db-query","rows":0,"text":"\n    SELECT\n\n      \n      TO_CHAR(\n        b.pickup_time::time,\n        'HH24'\n      )\n    \n      AS label,\n\n      COALESCE(\n        SUM(b.total_charges),\n        0\n      ) AS earnings\n\n    FROM bookings b\n\n    \n    WHERE b.trash = false\n    AND b.booking_status_id = 11\n   AND b.driver_id = $1\n      AND b.pickup_date::date = $2::date\n    \n\n    GROUP BY label\n\n    ORDER BY label\n  ","timestamp":"2026-06-08T06:12:06.734Z"}
