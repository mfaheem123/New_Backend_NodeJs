{"duration":3,"level":"info","message":"db-query","rows":22,"text":" SELECT l.*,\n                   to_json(lt) AS location_type\n            FROM locations l\n            LEFT JOIN location_types lt\n              ON lt.id = l.location_type_id\n            WHERE l.location_type_id = 2 AND l.company_id = $1\n            ORDER BY l.id ASC","timestamp":"2026-06-08T06:11:50.443Z"}
