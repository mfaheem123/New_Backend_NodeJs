{"duration":110,"level":"info","message":"db-query","rows":1,"text":"SELECT COUNT(DISTINCT cr.id) \n    FROM call_recordings cr\n    LEFT JOIN customers cust \n      ON (\n        cr.source = cust.mobile \n        OR cr.destination = cust.mobile\n        OR REPLACE(cr.source, '44', '0') = cust.mobile\n        OR REPLACE(cr.destination, '44', '0') = cust.mobile\n        OR cr.source = REGEXP_REPLACE(cust.mobile, '^0', '44')\n        OR cr.destination = REGEXP_REPLACE(cust.mobile, '^0', '44')\n      )\n      AND cust.company_id = cr.company_id\n    WHERE 1=1\n   AND cr.company_id = $1","timestamp":"2026-08-31T17:10:27.140Z"}
{"duration":3,"level":"info","message":"db-query","rows":14,"text":"\n    SELECT \n      cr.id AS _id,\n      cr.recording_id,\n      cr.authentication_token AS token,\n      cr.event_type,\n      cr.duration,\n      cr.recording_datetime AS datetime,\n      cr.source,\n      cr.destination,\n      cr.filename,\n      cr.file_path,\n      cust.name AS customer\n    \n    FROM call_recordings cr\n    LEFT JOIN customers cust \n      ON (\n        cr.source = cust.mobile \n        OR cr.destination = cust.mobile\n        OR REPLACE(cr.source, '44', '0') = cust.mobile\n        OR REPLACE(cr.destination, '44', '0') = cust.mobile\n        OR cr.source = REGEXP_REPLACE(cust.mobile, '^0', '44')\n        OR cr.destination = REGEXP_REPLACE(cust.mobile, '^0', '44')\n      )\n      AND cust.company_id = cr.company_id\n    WHERE 1=1\n   AND cr.company_id = $1\n    ORDER BY cr.recording_datetime DESC\n    LIMIT $2 OFFSET $3\n  ","timestamp":"2026-08-31T17:10:27.145Z"}
