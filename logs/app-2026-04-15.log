{"duration":5,"level":"info","message":"db-query","rows":1,"text":"\n        SELECT\n          pf.*,\n          vt.name AS vehicle_type_name,\n          pu.name AS pickup_plot_name,\n          dof.name AS dropoff_plot_name\n        FROM plot_fares pf\n        LEFT JOIN vehicle_types vt ON pf.vehicle_type_id = vt.id\n        LEFT JOIN zones pu ON pf.pickup_plot_id = pu.id\n        LEFT JOIN zones dof ON pf.dropoff_plot_id = dof.id\n        WHERE pf.id = $1\n      ","timestamp":"2026-04-15T07:24:06.950Z"}
