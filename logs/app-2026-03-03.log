{"duration":51,"level":"info","message":"db-query","rows":13,"text":"\n      SELECT dc.*,\n      json_build_object(\n        'username', d.username,\n        'email', d.email,\n        'subsidiary_id', d.subsidiary_id\n      ) AS driver\n      FROM driver_commissions dc\n      JOIN drivers d ON dc.driver_id = d.id\n      WHERE dc.driver_id = $1\n      ORDER BY dc.id DESC\n    ","timestamp":"2026-03-03T03:18:52.904Z"}
