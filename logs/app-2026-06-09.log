{"duration":517,"level":"info","message":"db-query","rows":1,"text":"\n        SELECT * FROM drivers \n        WHERE LOWER(username) = LOWER($1)\n        LIMIT 1\n    ","timestamp":"2026-06-09T17:42:03.898Z"}
{"duration":48,"level":"info","message":"db-query","rows":1,"text":"\n        UPDATE drivers\n        SET\n          session_status = 'logged_in',\n          driver_status = 'Available',\n          booking_status = 'Available',\n          last_login_at = NOW(),\n          latitude = $1,\n          longitude = $2\n        WHERE id = $3\n      ","timestamp":"2026-06-09T17:42:04.045Z"}
{"duration":26,"level":"info","message":"db-query","rows":1,"text":"\n    INSERT INTO driver_shift_histories (\n      driver_id,\n      login_date,\n      login_time,\n      login_latitude,\n      login_longitude\n    )\n    VALUES (\n      $1,\n\n      TO_CHAR(NOW(), 'YYYY-MM-DD'),\n      TO_CHAR(NOW(), 'HH24:MI'),\n\n      $2,\n      $3\n    )\n\n    RETURNING *;\n  ","timestamp":"2026-06-09T17:42:04.072Z"}
{"duration":1,"level":"info","message":"db-query","rows":1,"text":"\n    UPDATE drivers\n    SET \n      fcm_token = $1,\n      fcm_updated_at = NOW()\n    WHERE id = $2\n  ","timestamp":"2026-06-09T17:42:04.074Z"}
{"duration":2,"level":"info","message":"db-query","rows":1,"text":"SELECT * FROM drivers WHERE id = $1 LIMIT 1","timestamp":"2026-06-09T17:42:04.077Z"}
{"duration":1,"level":"info","message":"db-query","rows":null,"text":"BEGIN","timestamp":"2026-06-09T17:42:04.078Z"}
{"duration":5,"level":"info","message":"db-query","rows":1,"text":"SELECT d.*, s.name AS subsidiary_name\n       FROM drivers d\n       LEFT JOIN subsidiaries s ON s.id = d.subsidiary_id\n       WHERE d.id = $1","timestamp":"2026-06-09T17:42:04.084Z"}
{"duration":10,"level":"info","message":"db-query","rows":0,"text":"SELECT id, note, created_at, created_by\n       FROM driver_notes\n       WHERE driver_id = $1\n       ORDER BY created_at DESC","timestamp":"2026-06-09T17:42:04.094Z"}
{"duration":7,"level":"info","message":"db-query","rows":0,"text":"SELECT id, name, start_time, end_time\n       FROM driver_shifts\n       WHERE driver_id = $1\n       ORDER BY id ASC","timestamp":"2026-06-09T17:42:04.101Z"}
