ccount_id = a.id\n      LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n      LEFT JOIN departments d ON ai.department_id = d.id\n\n      \n      ORDER BY ai.id DESC\n      OFFSET $1\n      LIMIT $2\n    ","timestamp":"2026-02-12T13:54:31.229Z"}
