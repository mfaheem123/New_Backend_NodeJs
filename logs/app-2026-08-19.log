{"duration":118,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT COUNT(*) AS total\n    FROM bookings b\n    \n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    LEFT JOIN journey_types jt ON b.journey_type_id = jt.id\n    LEFT JOIN accounts a ON b.account_id = a.id\n    LEFT JOIN payment_types pt ON b.payment_type_id = pt.id\n    LEFT JOIN drivers d ON b.driver_id = d.id\n    LEFT JOIN subsidiaries s ON b.subsidiary_id = s.id\n    LEFT JOIN booking_statuses bs ON b.booking_status_id = bs.id\n  \n    \n    WHERE b.trash = false AND \n      TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n      >= TO_DATE($1, 'YYYY-MM-DD')\n     AND \n      TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n      <= TO_DATE($2, 'YYYY-MM-DD')\n     AND TRIM(b.pickup_time)::time >= $3::time AND TRIM(b.pickup_time)::time <= $4::time AND b.booking_status_id = ANY($5::int[]) AND b.payment_type_id = ANY($6::int[]) AND b.driver_id = $7 AND b.pickup ILIKE $8 AND b.parking_charges::text ILIKE $9 AND b.waiting_charges::text ILIKE $10 AND b.extra_drop_charges::text ILIKE $11 AND b.meet_and_greet::text ILIKE $12 AND b.congestion_charges::text ILIKE $13 AND b.total_charges::text ILIKE $14\n  \n  ","timestamp":"2026-08-19T11:44:17.712Z"}
{"duration":6,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      COUNT(*) AS total_bookings,\n      COALESCE(SUM(b.fares), 0) AS total_earnings,\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.account_id IS NOT NULL\n            THEN b.fares\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_account_earnings\n    FROM bookings b\n    \n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    LEFT JOIN journey_types jt ON b.journey_type_id = jt.id\n    LEFT JOIN accounts a ON b.account_id = a.id\n    LEFT JOIN payment_types pt ON b.payment_type_id = pt.id\n    LEFT JOIN drivers d ON b.driver_id = d.id\n    LEFT JOIN subsidiaries s ON b.subsidiary_id = s.id\n    LEFT JOIN booking_statuses bs ON b.booking_status_id = bs.id\n  \n    \n    WHERE b.trash = false AND \n      TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n      >= TO_DATE($1, 'YYYY-MM-DD')\n     AND \n      TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n      <= TO_DATE($2, 'YYYY-MM-DD')\n     AND TRIM(b.pickup_time)::time >= $3::time AND TRIM(b.pickup_time)::time <= $4::time AND b.booking_status_id = ANY($5::int[]) AND b.payment_type_id = ANY($6::int[]) AND b.driver_id = $7 AND b.pickup ILIKE $8 AND b.parking_charges::text ILIKE $9 AND b.waiting_charges::text ILIKE $10 AND b.extra_drop_charges::text ILIKE $11 AND b.meet_and_greet::text ILIKE $12 AND b.congestion_charges::text ILIKE $13 AND b.total_charges::text ILIKE $14\n  \n  ","timestamp":"2026-08-19T11:44:17.725Z"}
