{"duration":59,"level":"info","message":"db-query","rows":2,"text":"\n    SELECT \n      esh.id,\n      esh.employee_id,\n      esh.login_datetime,\n      esh.logout_datetime,\n\n      COALESCE(esh.bookings_created, 0) AS bookings_created,\n      COALESCE(esh.bookings_dispatched, 0) AS bookings_dispatched,\n      COALESCE(esh.bookings_cancelled, 0) AS bookings_cancelled,\n      COALESCE(esh.calls_answered, 0) AS calls_answered,\n\n      COALESCE(\n        EXTRACT(EPOCH FROM (\n          esh.logout_datetime - esh.login_datetime\n        )) * 1000,\n        0\n      ) AS working_hours\n\n    FROM employee_shift_history esh\n    WHERE esh.employee_id = $1\n   AND DATE(esh.login_datetime) BETWEEN $2 AND $3 AND COALESCE(esh.bookings_created, 0)::text ILIKE $4 AND COALESCE(esh.bookings_dispatched, 0)::text ILIKE $5 AND COALESCE(esh.bookings_cancelled, 0)::text ILIKE $6 AND COALESCE(esh.calls_answered, 0)::text ILIKE $7 ORDER BY esh.login_datetime ASC","timestamp":"2026-08-19T12:02:24.326Z"}
