{"duration":6,"level":"info","message":"db-query","rows":1,"text":"SELECT d.*, s.name AS subsidiary_name\n          FROM drivers d\n          LEFT JOIN subsidiaries s ON s.id = d.subsidiary_id\n          WHERE d.id = $1","timestamp":"2026-11-10T18:07:40.972Z"}
{"duration":3,"level":"info","message":"db-query","rows":1,"text":"SELECT id, note, created_at, created_by\n          FROM driver_notes\n          WHERE driver_id = $1\n          ORDER BY created_at DESC","timestamp":"2026-11-10T18:07:40.975Z"}
{"duration":5,"level":"info","message":"db-query","rows":2,"text":"SELECT id, name, start_time, end_time\n          FROM driver_shifts\n          WHERE driver_id = $1\n          ORDER BY id ASC","timestamp":"2026-11-10T18:07:40.981Z"}
{"duration":2,"level":"info","message":"db-query","rows":1,"text":"SELECT \n            v.*,\n            json_build_object(\n              'id', vt.id,\n              'name', vt.name,\n              'driver_waiting_charges', vt.driver_waiting_charges,\n              'account_waiting_charges', vt.account_waiting_charges,\n              'waiting_time', vt.waiting_time\n            ) AS vehicle_type\n            FROM vehicles v\n            LEFT JOIN vehicle_types vt ON vt.id = v.vehicle_type_id\n            WHERE v.id = $1\n            LIMIT 1","timestamp":"2026-11-10T18:07:40.983Z"}
