{"duration":1,"level":"info","message":"db-query","rows":1,"text":"SELECT \n            v.*,\n            json_build_object(\n              'id', vt.id,\n              'name', vt.name,\n              'driver_waiting_charges', vt.driver_waiting_charges,\n              'account_waiting_charges', vt.account_waiting_charges,\n              'waiting_time', vt.waiting_time\n            ) AS vehicle_type\n            FROM vehicles v\n            LEFT JOIN vehicle_types vt ON vt.id = v.vehicle_type_id\n            WHERE v.id = $1\n            LIMIT 1","timestamp":"2026-11-10T18:09:44.373Z"}
