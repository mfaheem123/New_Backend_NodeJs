n              -- Point in Polygon: Longitude intersection check\n              AND (\n                dr.longitude::DOUBLE PRECISION\n                <\n                (\n                  (\n                    COALESCE(e.lng2, e.first_lng) - e.lng1\n                  )\n                  *\n                  (\n                    dr.latitude::DOUBLE PRECISION - e.lat1\n                  )\n                  /\n                  NULLIF(\n                    COALESCE(e.lat2, e.first_lat) - e.lat1,\n                    0\n                  )\n                ) + e.lng1\n              )\n          )\n\n        WHERE z.company_id = $1\n\n        GROUP BY z.id\n      ),\n\n      \nzone_jobs AS (\n    SELECT\n        b.pickup_plot AS zone_id,\n\n        COUNT(*) FILTER (\n            WHERE\n                b.pickup_date::DATE +\n                COALESCE(b.pickup_time::TIME, TIME '00:00:00')\n                <= NOW()\n        )::INTEGER AS j0_jobs,\n\n        COUNT(*) FILTER (\n            WHERE\n                b.pickup_date::DATE +\n                COALESCE(b.pickup_time::TIME, TIME '00:00:00')\n                > NOW()\n                AND\n                b.pickup_date::DATE +\n                COALESCE(b.pickup_time::TIME, TIME '00:00:00')\n                <= NOW() + INTERVAL '10 minutes'\n        )::INTEGER AS j10_jobs,\n\n        COUNT(*) FILTER (\n            WHERE\n                b.pickup_date::DATE +\n                COALESCE(b.pickup_time::TIME, TIME '00:00:00')\n                > NOW() + INTERVAL '10 minutes'\n                AND\n                b.pickup_date::DATE +\n                COALESCE(b.pickup_time::TIME, TIME '00:00:00')\n                <= NOW() + INTERVAL '30 minutes'\n        )::INTEGER AS j30_jobs\n\n    FROM bookings b\n\n    INNER JOIN zones z\n        ON z.id = b.pickup_plot\n        AND z.company_id = b.company_id\n\n    WHERE b.trash = false\n      AND b.hidden = false\n      AND b.completed = false\n      AND b.driver_id IS NULL\n      AN