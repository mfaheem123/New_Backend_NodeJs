{"duration":3,"level":"info","message":"db-query","rows":22,"text":"\n    SELECT \n      l.id,\nl.name,\nl.location_type_id,\nl.address,\nl.postcode,\nl.zone_id,\nl.shortcut,\nl.background_color,\nl.foreground_color,\nl.extra_charges,\nl.pickup_charges,\nl.dropoff_charges,\nl.blacklist,\nl.latitude,\nl.longitude, \n      jsonb_build_object(\n        'id', lt.id,\n        'name', lt.name,\n        'shortcut', lt.shortcut,\n        'background_color', lt.background_color,\n        'foreground_color', lt.foreground_color\n      ) AS location_type,\n      z.name AS zone\n    FROM locations l\n    LEFT JOIN location_types lt ON l.location_type_id = lt.id\n    LEFT JOIN zones z ON l.zone_id = z.id\n    \n    ORDER BY l.id ASC\n    LIMIT $1 OFFSET $2;\n  ","timestamp":"2026-09-18T17:04:26.038Z"}
