{"duration":15,"level":"info","message":"db-query","rows":1,"text":"\n      SELECT \n        ai.*,\n\n        -- ACCOUNT OBJECT\n        json_build_object(\n          'id', a.id,\n          'name', a.name,\n          'email', a.email,\n          'subsidiary_id', a.subsidiary_id,\n          'subsidiary',\n          json_build_object(\n            'id', s.id,\n            'name', s.name\n          )\n        ) as account,\n\n        -- DEPARTMENT OBJECT\n        CASE \n          WHEN d.id IS NOT NULL THEN \n            json_build_object(\n              'id', d.id,\n              'name', d.name\n            )\n          ELSE NULL\n        END as account_department,\n\n        -- LINE ITEMS WITH BOOKINGS\n        COALESCE(\n          json_agg(\n            DISTINCT jsonb_build_object(\n              'id', ail.id,\n              'account_invoice_id', ail.account_invoice_id,\n              'booking_id', ail.booking_id,\n              'booking',\n              jsonb_build_object(\n                'id', b.id,\n                'reference_number', b.reference_number,\n                'pickup', b.pickup,\n                'dropoff', b.dropoff,\n                'pickup_date', b.pickup_date,\n                'pickup_time', b.pickup_time,\n                'total_charges', b.total_charges,\n                'invoice_status', b.invoice_status\n              )\n            )\n          ) FILTER (WHERE ail.id IS NOT NULL),\n          '[]'\n        ) AS account_invoice_lineitems\n\n      FROM account_invoices ai\n\n      LEFT JOIN accounts a ON ai.account_id = a.id\n      LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n      LEFT JOIN departments d ON ai.department_id = d.id\n\n      LEFT JOIN account_invoice_lineitems ail \n        ON ail.account_invoice_id = ai.id\n\n      LEFT JOIN bookings b \n        ON b.id = ail.booking_id\n\n      WHERE ai.id = $1\n\n      GROUP BY ai.id, a.id, s.id, d.id\n    ","timestamp":"2026-02-19T05:20:56.282Z"}
