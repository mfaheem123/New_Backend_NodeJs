{"duration":11,"level":"info","message":"db-query","rows":1,"text":"\n      SELECT \n        ai.*,\n\n        json_build_object(\n          'id', a.id,\n          'name', a.name,\n          'email', a.email,\n          'subsidiary_id', a.subsidiary_id,\n          'subsidiary',\n          json_build_object(\n            'id', s.id,\n            'name', s.name\n          )\n        ) as account,\n\n        CASE \n          WHEN d.id IS NOT NULL THEN \n            json_build_object(\n              'id', d.id,\n              'name', d.name\n            )\n          ELSE NULL\n        END as department,\n\n        -- 🔥 BOOKINGS ARRAY\n        COALESCE(\n          json_agg(\n            DISTINCT jsonb_build_object(\n              'id', b.id,\n              'reference_number', b.reference_number,\n              'pickup', b.pickup,\n              'dropoff', b.dropoff,\n              'pickup_date', b.pickup_date,\n              'pickup_time', b.pickup_time,\n              'total_charges', b.total_charges,\n              'invoice_status', b.invoice_status,\n              'stripe_payment_id', b.stripe_payment_id\n            )\n          ) FILTER (WHERE b.id IS NOT NULL),\n          '[]'\n        ) as bookings\n\n      FROM account_invoices ai\n\n      LEFT JOIN accounts a ON ai.account_id = a.id\n      LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n      LEFT JOIN departments d ON ai.department_id = d.id\n\n      -- 🔥 Correct Relation\n      LEFT JOIN bookings b \n        ON b.invoice_number = ai.invoice_number\n\n      WHERE ai.id = $1\n\n      GROUP BY ai.id, a.id, s.id, d.id\n    ","timestamp":"2026-02-19T05:12:15.751Z"}
