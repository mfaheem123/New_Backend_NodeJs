{"duration":86,"level":"info","message":"db-query","rows":13,"text":"\n    SELECT \n      c.*,\n      COALESCE(\n        JSON_AGG(\n          JSON_BUILD_OBJECT(\n            'id', d.driver_id,\n            'username', d.driver_username,\n            'name', d.driver_name\n          )\n        ) FILTER (WHERE d.driver_id IS NOT NULL),\n        '[]'\n      ) AS restricted_drivers\n    FROM customers c\n    LEFT JOIN customer_restricted_drivers d ON c.id = d.customer_id\n    WHERE c.blacklist = $1\n    GROUP BY c.id\n    ORDER BY c.id DESC\n    LIMIT $2 OFFSET $3;\n  ","timestamp":"2026-02-19T03:33:22.707Z"}
{"duration":92,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT COUNT(*) AS total\n    FROM customers c\n    WHERE c.blacklist = $1;\n  ","timestamp":"2026-02-19T03:33:22.714Z"}
