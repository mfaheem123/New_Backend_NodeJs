{"duration":3,"level":"info","message":"db-query","rows":0,"text":"\n    SELECT \n      f.*, \n      vt.name AS vehicle_type_name, \n      vt.minimum_fares AS vehicle_minimum_fare,\n      a.name AS account_name\n    FROM fare_configurations f\n    LEFT JOIN vehicle_types vt ON vt.id = f.vehicle_type_id\n    LEFT JOIN accounts a ON a.id = f.account_id\n    WHERE f.vehicle_type_id = $1\n    AND LOWER(f.from_day) = LOWER($2)\n    AND (\n      f.from_time <= $3 AND f.to_time >= $3\n    )\n    ORDER BY f.id DESC;\n  ","timestamp":"2026-04-03T12:29:00.022Z"}
