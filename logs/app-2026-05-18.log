{"duration":21,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      d.id AS driver_id,\n      d.username,\n      d.name,\n      d.driver_status,\n      d.session_status,\n\n      COUNT(b.id) AS total_bookings,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.total_charges\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_earnings\n\n    FROM bookings b\n\n    LEFT JOIN drivers d\n      ON b.driver_id = d.id\n\n    WHERE b.trash = false\n      AND b.pickup_date::date\n      BETWEEN $1::date\n      AND $2::date\n    \n\n    GROUP BY\n      d.id,\n      d.username,\n      d.name,\n      d.driver_status\n\n    ORDER BY total_bookings DESC\n  ","timestamp":"2026-05-18T07:05:06.111Z"}
