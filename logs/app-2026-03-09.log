' || ld.name || '%'\nLEFT JOIN location_types ltp ON lp.location_type_id = ltp.id\nLEFT JOIN location_types ltd ON ld.location_type_id = ltd.id\n\n\n\n    WHERE b.driver_id = $1 AND b.booking_status_id = 11\n    AND b.pickup_date::date >= CURRENT_DATE - INTERVAL '7 days'\n  \n    ORDER BY \n      b.pickup_date DESC,\n      b.pickup_time DESC\n  ","timestamp":"2026-03-09T06:21:59.888Z"}
