{"duration":16,"level":"info","message":"db-query","rows":0,"text":"\n            SELECT \n                d.id,\n                d.username,\n                d.name,\n                d.mobile,\n                v.vehicle_number,\n                v.make,\n                v.model,\n                v.color,\n                vt.id AS vt_id,\n                vt.name AS vt_name,\n                vt.passengers AS vt_passengers,\n                vt.luggages AS vt_luggages\n            FROM driver_sinbins sb\n            INNER JOIN drivers d ON sb.driver_id = d.id\n            LEFT JOIN vehicles v ON d.id = v.driver_id\n            LEFT JOIN vehicle_types vt ON v.vehicle_type_id = vt.id\n            WHERE sb.company_id = $1 AND sb.sinbin_time > 0 AND sb.is_active = TRUE;\n        ","timestamp":"2026-09-28T12:16:47.781Z"}
