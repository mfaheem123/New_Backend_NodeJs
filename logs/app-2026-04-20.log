{"duration":4,"level":"info","message":"db-query","rows":1,"text":"SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.driver_status,\n      d.booking_status,\n      d.session_status,\n      d.latitude,\n      d.longitude,\n      d.last_login_at,\n      vt.name AS vehicle_type\n   FROM drivers d\n   LEFT JOIN vehicles v ON d.vehicle_id = v.id\n   LEFT JOIN vehicle_types vt ON v.vehicle_type_id = vt.id\n   WHERE d.id = $1","timestamp":"2026-04-20T13:58:36.081Z"}
