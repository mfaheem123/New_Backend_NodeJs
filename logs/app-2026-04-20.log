{"duration":7,"level":"info","message":"db-query","rows":8,"text":"\n      SELECT\n        bt.id,\n        bt.booking_tabs,\n        CASE bt.id\n          WHEN 1 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) = CURRENT_DATE \n            AND booking_status_id = 1 AND trash = false\n          )\n          WHEN 2 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) > CURRENT_DATE AND trash = false\n          )\n          WHEN 3 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id != 11 AND booking_status_id != 1 AND trash = false\n          )\n          WHEN 4 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id = 11 AND trash = false\n          )\n          WHEN 5 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE quoted = true AND trash = false\n          )\n          WHEN 6 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'ivr' AND trash = false\n          )\n          WHEN 7 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'web' AND trash = false\n          )\n          WHEN 8 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'app' AND trash = false\n          )\n        END::int AS booking_count\n      FROM booking_tabs bt\n      ORDER BY bt.id ASC\n    ","timestamp":"2026-04-20T11:49:52.066Z"}
{"duration":3,"level":"info","message":"db-query","rows":6,"text":"SELECT \n      f.*, \n      vt.name AS vehicle_type_name, \n      vt.minimum_fares AS vehicle_minimum_fare\n        FROM fare_configurations f\n          LEFT JOIN vehicle_types vt ON vt.id = f.vehicle_type_id\n        ORDER BY id ASC","timestamp":"2026-04-20T11:49:52.069Z"}
{"duration":3,"level":"info","message":"db-query","rows":5,"text":"SELECT \n    f.*,\n    vt.name AS vehicle_type_name,\n    lf.name AS from_location_name,\n    lt.name AS to_location_name\n      FROM fixed_fares f\n        JOIN vehicle_types vt \n          ON f.vehicle_type_id = vt.id\n        JOIN location_types lf \n           ON f.from_location_id = lf.id\n        JOIN location_types lt \n          ON f.to_location_id = lt.id\n      ORDER BY f.id ASC","timestamp":"2026-04-20T11:49:52.072Z"}
{"duration":3,"level":"info","message":"db-query","rows":13,"text":"SELECT \n        pf.*, \n        vt.name AS vehicle_type_name,\n        p1.id AS pickup_plot_id, p1.name AS pickup_plot_name,\n        p2.id AS dropoff_plot_id, p2.name AS dropoff_plot_name\n      FROM plot_fares pf\n      JOIN vehicle_types vt ON vt.id = pf.vehicle_type_id\n      JOIN zones p1 ON p1.id = pf.pickup_plot_id\n      JOIN zones p2 ON p2.id = pf.dropoff_plot_id\n      ORDER BY pf.id ASC","timestamp":"2026-04-20T11:49:52.076Z"}
{"duration":2,"level":"info","message":"db-query","rows":5,"text":" SELECT fbv.*, row_to_json(vt) as vehicle_type\n    FROM fare_by_vehicles fbv\n    LEFT JOIN vehicle_types vt ON fbv.vehicle_type_id = vt.id\n    ORDER BY fbv.id ASC","timestamp":"2026-04-20T11:49:52.078Z"}
{"duration":1,"level":"info","message":"db-query","rows":22,"text":" SELECT l.*,\n                   to_json(lt) AS location_type\n            FROM locations l\n            LEFT JOIN location_types lt\n              ON lt.id = l.location_type_id\n            WHERE l.location_type_id = 2\n            ORDER BY l.id ASC","timestamp":"2026-04-20T11:49:52.080Z"}
{"level":"info","message":"GET /api/enumerations/get 304 149.585 ms","timestamp":"2026-04-20T11:49:52.082Z"}
{"duration":3,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      a.id,a.subsidiary_id,a.account_type,a.name,a.email,a.mobile,a.payment_types,a.information,a.background_color,a.foreground_color,\n      json_agg(DISTINCT jsonb_build_object('id', d.id, 'name', d.name)) AS departments,\n      jsonb_build_object(\n        'id', s.id,\n        'name', s.name,\n        'telephone_number', s.telephone_number,\n        'email', s.email\n      ) AS subsidiary\n    FROM accounts a\n    LEFT JOIN departments d ON a.id = d.account_id\n    LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n    WHERE a.subsidiary_id = $1\n    GROUP BY a.id, s.id\n    ORDER BY a.id ASC;\n  ","timestamp":"2026-04-20T11:49:52.111Z"}
