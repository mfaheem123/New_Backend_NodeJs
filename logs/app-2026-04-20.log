{"duration":83,"level":"info","message":"db-query","rows":1,"text":"SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.driver_status,\n      d.booking_status,\n      d.session_status,\n      d.latitude,\n      d.longitude,\n      d.last_login_at,\n      vt.name AS vehicle_type\n   FROM drivers d\n   LEFT JOIN vehicles v ON d.vehicle_id = v.id\n   LEFT JOIN vehicle_types vt ON v.vehicle_type_id = vt.id\n   WHERE d.id = $1","timestamp":"2026-04-20T13:57:07.297Z"}
{"duration":3,"level":"info","message":"db-query","rows":1,"text":"UPDATE drivers SET latitude=$1, longitude=$2 WHERE id=$3","timestamp":"2026-04-20T13:57:07.300Z"}
{"duration":2,"level":"info","message":"db-query","rows":1,"text":"INSERT INTO driver_location_logs (driver_id, latitude, longitude)\n           VALUES ($1,$2,$3)","timestamp":"2026-04-20T13:57:07.302Z"}
