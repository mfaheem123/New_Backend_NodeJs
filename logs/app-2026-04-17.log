{"duration":8,"level":"info","message":"db-query","rows":5,"text":"\n    SELECT \n      f.*, \n      vt.name AS vehicle_type_name, \n      vt.minimum_fares AS vehicle_minimum_fare,\n      a.name AS account_name\n    FROM fare_configurations f\n    LEFT JOIN vehicle_types vt ON vt.id = f.vehicle_type_id\n    LEFT JOIN accounts a ON a.id = f.account_id\n   WHERE f.title IS NULL OR TRIM(f.title) = '' ORDER BY f.id DESC","timestamp":"2026-04-17T07:16:26.506Z"}
