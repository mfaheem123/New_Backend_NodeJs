{"duration":179,"level":"info","message":"db-query","rows":2,"text":"\n    SELECT \n      c.*,\n      COALESCE(\n        JSON_AGG(\n          JSON_BUILD_OBJECT(\n            'id', d.driver_id,\n            'username', d.driver_username,\n            'name', d.driver_name\n          )\n        ) FILTER (WHERE d.driver_id IS NOT NULL),\n        '[]'\n      ) AS restricted_drivers\n    FROM customers c\n    LEFT JOIN customer_restricted_drivers d ON c.id = d.customer_id\n    WHERE c.blacklist = $1\n    GROUP BY c.id\n    ORDER BY c.id DESC\n    LIMIT $2 OFFSET $3;\n  ","timestamp":"2026-02-16T14:18:50.031Z"}
