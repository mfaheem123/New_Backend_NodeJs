{"duration":1,"level":"info","message":"db-query","rows":1,"text":"INSERT INTO driver_commission_lineitems\n           (driver_commission_id, booking_id)\n           VALUES ($1,$2)","timestamp":"2026-03-07T05:17:16.248Z"}
