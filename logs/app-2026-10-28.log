{"duration":30,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      id,\n      company_id,\n      mobile AS number,\n      message AS sms,\n      TO_CHAR(created_at AT TIME ZONE 'Europe/London', 'YYYY-MM-DD') AS date,\n      TO_CHAR(created_at AT TIME ZONE 'Europe/London', 'HH24:MI:SS') AS time,\n      LOWER(status) AS status\n    FROM sms_logs\n    WHERE 1=1\n   AND company_id = $1 AND mobile ILIKE $2 AND message ILIKE $3 AND TO_CHAR(created_at AT TIME ZONE 'Europe/London', 'YYYY-MM-DD') ILIKE $4 AND TO_CHAR(created_at AT TIME ZONE 'Europe/London', 'HH24:MI:SS') ILIKE $5 AND status ILIKE $6 ORDER BY id DESC LIMIT $7 OFFSET $8","timestamp":"2026-10-28T18:23:16.960Z"}
