{"duration":13,"level":"info","message":"db-query","rows":1,"text":"\n        UPDATE driver_rents\n        SET transaction_date = $1, driver_id = $2, jobs_total = $3, rent_total = $4, cash_jobs_total = $5, account_jobs_total = $6, owed = $7, old_balance = $8, current_balance = $9, from_date = $10, to_date = $11, last_modified = $12\n        WHERE id = $13\n        RETURNING *;\n      ","timestamp":"2026-03-17T10:57:24.563Z"}
{"duration":3,"level":"info","message":"db-query","rows":3,"text":"DELETE FROM driver_rent_lineitems WHERE driver_rent_id = $1","timestamp":"2026-03-17T10:57:24.567Z"}
{"duration":9,"level":"info","message":"db-query","rows":1,"text":"INSERT INTO driver_rent_lineitems\n           (driver_rent_id, booking_id)\n           VALUES ($1,$2)","timestamp":"2026-03-17T10:57:24.579Z"}
{"duration":1,"level":"info","message":"db-query","rows":1,"text":"INSERT INTO driver_rent_lineitems\n           (driver_rent_id, booking_id)\n           VALUES ($1,$2)","timestamp":"2026-03-17T10:57:24.581Z"}
{"duration":1,"level":"info","message":"db-query","rows":1,"text":"INSERT INTO driver_rent_lineitems\n           (driver_rent_id, booking_id)\n           VALUES ($1,$2)","timestamp":"2026-03-17T10:57:24.583Z"}
{"duration":3,"level":"info","message":"db-query","rows":1,"text":"UPDATE drivers SET balance = $1 WHERE id = $2","timestamp":"2026-03-17T10:57:24.586Z"}
{"duration":2,"level":"info","message":"db-query","rows":null,"text":"COMMIT","timestamp":"2026-03-17T10:57:24.588Z"}
{"duration":2,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      dc.id,\n      dc.transaction_number,\n      dc.transaction_date,\n      dc.driver_id,\n      dc.jobs_total ,\n      dc.rent_total ,\n      dc.cash_jobs_total ,\n      dc.account_jobs_total ,\n      dc.owed ,\n      dc.old_balance ,\n      dc.current_balance ,\n      dc.from_date,\n      dc.to_date,\n      dc.payment_type,\n      dc.last_modified,\n\n      -- Limited Driver Object\n      json_build_object(\n        'id', d.id,\n        'name', d.name,\n        'username', d.username,\n        'email', d.email,\n        'driver_commission', d.driver_commission,\n        'pda_rent', d.pda_rent,\n        'balance', d.balance,\n        'subsidiary_id', d.subsidiary_id\n      ) AS driver\n\n    FROM driver_rents dc\n    JOIN drivers d ON dc.driver_id = d.id\n    WHERE dc.id = $1\n  ","timestamp":"2026-03-17T10:57:24.590Z"}
{"duration":15,"level":"info","message":"db-query","rows":0,"text":"\n    SELECT \n      dcl.id,\n      dcl.driver_rent_id,\n      dcl.booking_id,\n\n      json_build_object(\n        'id', b.id,\n        'reference_number', b.reference_number,\n        'pickup_date', b.pickup_date,\n        'pickup_time', b.pickup_time,\n        'pickup', b.pickup,\n        'dropoff', b.dropoff,\n        'viapoints', b.viapoints,\n        'name', b.name,\n        'fares', b.fares::text,\n        'parking_charges', b.parking_charges::text,\n        'waiting_charges', b.waiting_charges::text,\n        'extra_drop_charges', b.extra_drop_charges::text,\n        'congestion_charges', b.congestion_charges::text,\n        'total_charges', b.total_charges::text,\n        'commission', b.commission,\n\n        'journey_type', \n          json_build_object('journey_type', jt.journey_type),\n\n        'payment_type',\n          json_build_object('name', pt.name),\n\n        'vehicle_type',\n          json_build_object('name', vt.name),\n\n        'account',\n          CASE \n            WHEN a.id IS NOT NULL \n            THEN json_build_object('name', a.name)\n            ELSE NULL\n          END\n      ) AS booking\n\n    FROM driver_rent_lineitems dcl\n    JOIN bookings b ON dcl.booking_id = b.id\n    LEFT JOIN journey_types jt ON b.journey_type_id = jt.id\n    LEFT JOIN payment_types pt ON b.payment_type_id = pt.id\n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    LEFT JOIN accounts a ON b.account_id = a.id\n    WHERE dcl.driver_rent_id = $1\n  ","timestamp":"2026-03-17T10:57:24.606Z"}
{"level":"info","message":"POST /api/driver_rent/update/2 200 119.378 ms","timestamp":"2026-03-17T10:57:24.608Z"}
