{"duration":2,"level":"info","message":"db-query","rows":4,"text":"SELECT * FROM payment_types ORDER BY id ASC","timestamp":"2026-02-28T05:34:13.766Z"}
{"duration":3,"level":"info","message":"db-query","rows":6,"text":"SELECT * FROM vehicle_types ORDER BY id ASC","timestamp":"2026-02-28T05:34:13.774Z"}
