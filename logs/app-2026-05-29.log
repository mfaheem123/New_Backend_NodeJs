{"duration":60,"level":"info","message":"db-query","rows":17,"text":"\n    SELECT\n      b.pickup_date::date AS date,\n\n      pt.name AS payment_type,\n\n      COUNT(b.id) AS total_bookings,\n\n      COALESCE(SUM(b.fares), 0) AS total_fares\n\n    FROM bookings b\n\n    LEFT JOIN payment_types pt\n      ON pt.id = b.payment_type_id\n\n    \n    WHERE b.trash = false AND b.booking_status_id = $1\n  \n\n    GROUP BY\n      b.pickup_date::date,\n      pt.name\n\n    ORDER BY\n      b.pickup_date::date ASC\n  ","timestamp":"2026-05-29T07:32:03.272Z"}
{"level":"info","message":"GET /api/bookings/booking-statistics-graph?booking_status_id=11 200 63.180 ms","timestamp":"2026-05-29T07:32:03.274Z"}
