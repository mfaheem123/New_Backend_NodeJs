{"duration":7,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      c.*,\n      COALESCE(\n        JSON_AGG(\n          JSON_BUILD_OBJECT(\n            'id', d.driver_id,\n            'username', d.driver_username,\n            'name', d.driver_name\n          )\n        ) FILTER (WHERE d.driver_id IS NOT NULL),\n        '[]'\n      ) AS restricted_drivers\n    FROM customers c\n    LEFT JOIN customer_restricted_drivers d ON c.id = d.customer_id\n    WHERE c.id = $1\n    GROUP BY c.id\n  ","timestamp":"2026-04-09T12:05:07.274Z"}
