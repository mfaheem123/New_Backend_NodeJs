{"duration":2,"level":"info","message":"db-query","rows":22,"text":" SELECT l.*,\n                   to_json(lt) AS location_type\n            FROM locations l\n            LEFT JOIN location_types lt\n              ON lt.id = l.location_type_id\n            WHERE l.location_type_id = 2\n            ORDER BY l.id ASC","timestamp":"2026-04-22T07:03:57.190Z"}
