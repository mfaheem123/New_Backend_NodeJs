{"duration":3,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      a.*,\n      json_agg(DISTINCT jsonb_build_object('id', d.id, 'name', d.name)) AS departments,\n      jsonb_build_object(\n        'id', s.id,\n        'name', s.name,\n        'telephone_number', s.telephone_number,\n        'email', s.email\n      ) AS subsidiary\n    FROM accounts a\n    LEFT JOIN departments d ON a.id = d.account_id\n    LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n    \n    GROUP BY a.id, s.id\n    ORDER BY a.id ASC\n    OFFSET $1 LIMIT $2;\n  ","timestamp":"2026-01-27T18:25:50.958Z"}
