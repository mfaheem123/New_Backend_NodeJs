{"duration":17,"level":"info","message":"db-query","rows":2,"text":"\n    SELECT\n      v.id AS vehicle_id,\n      COALESCE(v.vehicle_number, '') AS vehicle_number,\n      COALESCE(v.make, '') AS vehicle_make,\n      COALESCE(vt.name, '') AS vehicle_type,\n      COALESCE(v.phc_vehicle_number, d.phc_vehicle_number, '') AS phc_vehicle_number,\n      COUNT(b.id)::text AS count\n    FROM bookings b\n    LEFT JOIN drivers d\n      ON b.driver_id = d.id\n    INNER JOIN vehicles v\n      ON COALESCE(b.vehicle_id, d.vehicle_id) = v.id\n    LEFT JOIN vehicle_types vt\n      ON COALESCE(v.vehicle_type_id, b.vehicle_type_id) = vt.id\n    WHERE b.trash = false AND b.booking_status_id = ANY($1::int[]) AND v.id IS NOT NULL AND b.pickup_date::date >= $2::date AND b.pickup_date::date <= $3::date AND b.subsidiary_id = $4\n    GROUP BY\n      v.id,\n      v.vehicle_number,\n      v.make,\n      vt.name,\n      v.phc_vehicle_number,\n      d.phc_vehicle_number\n    ORDER BY v.id ASC\n  ","timestamp":"2026-11-20T13:06:46.618Z"}
