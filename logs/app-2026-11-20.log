{"duration":3,"level":"info","message":"db-query","rows":2,"text":"\n    SELECT\n      d.id AS driver_id,\n      d.username,\n      d.phc_driver_number,\n      SPLIT_PART(TRIM(COALESCE(d.name, '')), ' ', 1) AS first_name,\n      CASE\n        WHEN POSITION(' ' IN TRIM(COALESCE(d.name, ''))) > 0\n          THEN SUBSTRING(TRIM(COALESCE(d.name, '')) FROM POSITION(' ' IN TRIM(COALESCE(d.name, ''))) + 1)\n        ELSE ''\n      END AS last_name,\n      COALESCE(d.name, '') AS driver_name,\n      COALESCE(v.vehicle_number, d.phc_vehicle_number, '') AS vehicle_number,\n      COALESCE(vt.name, '') AS vehicle_type,\n      COUNT(b.id)::text AS count\n    FROM bookings b\n    INNER JOIN drivers d\n      ON b.driver_id = d.id\n    LEFT JOIN vehicles v\n      ON COALESCE(b.vehicle_id, d.vehicle_id) = v.id\n    LEFT JOIN vehicle_types vt\n      ON COALESCE(b.vehicle_type_id, v.vehicle_type_id) = vt.id\n    WHERE b.trash = false AND b.driver_id IS NOT NULL AND b.booking_status_id = ANY($1::int[]) AND b.pickup_date::date >= $2::date AND b.pickup_date::date <= $3::date AND b.subsidiary_id = $4\n    GROUP BY\n      d.id,\n      d.username,\n      d.phc_driver_number,\n      d.name,\n      v.vehicle_number,\n      d.phc_vehicle_number,\n      vt.name\n    ORDER BY d.id ASC\n  ","timestamp":"2026-11-20T13:09:01.801Z"}
