{"duration":8,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      d.id AS driver_id,\n      d.username,\n      d.name,\n      d.driver_status,\n      d.session_status,\n\n      COUNT(b.id) AS total_bookings,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.total_charges\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_earnings\n\n    FROM bookings b\n\n    LEFT JOIN drivers d\n      ON b.driver_id = d.id\n\n    WHERE b.trash = false AND b.driver_id = $1\n\n    GROUP BY\n      d.id,\n      d.username,\n      d.name,\n      d.driver_status\n\n    ORDER BY total_bookings DESC\n  ","timestamp":"2026-05-15T10:46:13.913Z"}
{"level":"info","message":"GET /api/bookings/booking-driver-statistics?driver_id=167 200 10.826 ms","timestamp":"2026-05-15T10:46:13.914Z"}
{"duration":56,"level":"info","message":"db-query","rows":4,"text":"\n    SELECT\n      d.id AS driver_id,\n      d.username,\n      d.name,\n      d.driver_status,\n      d.session_status,\n\n      COUNT(b.id) AS total_bookings,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.total_charges\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_earnings\n\n    FROM bookings b\n\n    LEFT JOIN drivers d\n      ON b.driver_id = d.id\n\n    WHERE b.trash = false\n\n    GROUP BY\n      d.id,\n      d.username,\n      d.name,\n      d.driver_status\n\n    ORDER BY total_bookings DESC\n  ","timestamp":"2026-05-15T10:46:28.809Z"}
