{"duration":195,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      COUNT(b.id) AS total_bookings,\n\n      COUNT(\n        CASE\n          WHEN b.booking_status_id = 11\n          THEN 1\n        END\n      ) AS completed_bookings,\n\n      COUNT(\n        CASE\n          WHEN b.booking_status_id != 11\n          THEN 1\n        END\n      ) AS pending_bookings,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.fares\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_fares,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.total_charges\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_charges,\n\n      COUNT(DISTINCT b.driver_id) AS total_drivers,\n\n      COUNT(\n        DISTINCT CASE\n          WHEN d.driver_status = 'Available'\n          THEN d.id\n        END\n      ) AS available_drivers,\n\n      COUNT(\n        DISTINCT CASE\n          WHEN d.driver_status = 'Unavailable'\n          THEN d.id\n        END\n      ) AS busy_drivers\n\n    FROM bookings b\n    LEFT JOIN drivers d\n      ON b.driver_id = d.id\n\n    WHERE b.trash = false\n  ","timestamp":"2026-05-15T09:35:05.210Z"}
{"level":"info","message":"GET /api/bookings/booking-driver-statistics 200 197.746 ms","timestamp":"2026-05-15T09:35:05.211Z"}
{"duration":54,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      COUNT(b.id) AS total_bookings,\n\n      COUNT(\n        CASE\n          WHEN b.booking_status_id = 11\n          THEN 1\n        END\n      ) AS completed_bookings,\n\n      COUNT(\n        CASE\n          WHEN b.booking_status_id != 11\n          THEN 1\n        END\n      ) AS pending_bookings,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.fares\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_fares,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.booking_status_id = 11\n            THEN b.total_charges\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_charges,\n\n      COUNT(DISTINCT b.driver_id) AS total_drivers,\n\n      COUNT(\n        DISTINCT CASE\n          WHEN d.driver_status = 'Available'\n          THEN d.id\n        END\n      ) AS available_drivers,\n\n      COUNT(\n        DISTINCT CASE\n          WHEN d.driver_status = 'Unavailable'\n          THEN d.id\n        END\n      ) AS busy_drivers\n\n    FROM bookings b\n    LEFT JOIN drivers d\n      ON b.driver_id = d.id\n\n    WHERE b.trash = false AND b.driver_id = $1\n  ","timestamp":"2026-05-15T09:37:09.357Z"}
