{"duration":172,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      b.*,\n      vt.name as vehicle_type_name,\n      d.name as driver_name,\n      v.color,\n      v.make,\n      v.model,\n      v.vehicle_number\n    FROM bookings b\n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    LEFT JOIN drivers d ON b.driver_id = d.id\n    LEFT JOIN vehicles v ON d.vehicle_id = v.id\n    WHERE b.id = $1 AND trash = false\n  ","timestamp":"2026-05-15T06:59:29.849Z"}
{"duration":0,"level":"info","message":"db-query","rows":0,"text":"SELECT fcm_token FROM drivers WHERE id = $1","timestamp":"2026-05-15T06:59:29.850Z"}
