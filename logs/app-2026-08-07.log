{"duration":76,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      c.id,\n  c.name,\n  c.email,\n  c.mobile,\n  c.telephone,\n  c.fax,\n  c.door_number,\n  c.address1,\n  c.address2,\n  c.blacklist,\n  c.blacklist_reason,\n  c.notes,\n  c.username,\n  c.password,\n  c.web_device_id,\n  c.mobile_device_id,\n  c.email_verification_code,\n  c.mobile_verification_code,\n  c.email_verified,\n  c.mobile_verified,\n  c.email_verified_at,\n  c.mobile_verified_at,\n  c.sms_flag,\n  c.created_at,\n  c.otp_created_at,\n  c.profile_image,\n  c.fcm_token,\n  c.fcm_updated_at,\n      COALESCE(\n        JSON_AGG(\n          JSON_BUILD_OBJECT(\n            'id', d.driver_id,\n            'username', d.driver_username,\n            'name', d.driver_name\n          )\n        ) FILTER (WHERE d.driver_id IS NOT NULL),\n        '[]'\n      ) AS restricted_drivers\n    FROM customers c\n    LEFT JOIN customer_restricted_drivers d ON c.id = d.customer_id\n    WHERE c.blacklist = $1 AND c.company_id = $2\n    GROUP BY c.id\n    ORDER BY c.id DESC\n    LIMIT $3 OFFSET $4;\n  ","timestamp":"2026-08-07T18:06:01.017Z"}
