{"duration":1,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      COUNT(*) AS total_bookings,\n\n      COALESCE(SUM(b.fares), 0) AS total_earnings,\n\n      COALESCE(\n        SUM(\n          CASE\n            WHEN b.account_id IS NOT NULL\n            THEN b.fares\n            ELSE 0\n          END\n        ),\n        0\n      ) AS total_account_earnings\n\n    FROM bookings b\n    \n    WHERE b.trash = false AND \n    TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n    >= TO_DATE($1, 'YYYY-MM-DD')\n   AND \n    TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n    <= TO_DATE($2, 'YYYY-MM-DD')\n   AND TRIM(b.pickup_time)::time >= $3::time AND TRIM(b.pickup_time)::time <= $4::time AND b.booking_status_id = ANY($5::int[]) AND b.payment_type_id = ANY($6::int[]) AND b.driver_id = $7\n  \n  ","timestamp":"2026-07-21T13:51:07.881Z"}
