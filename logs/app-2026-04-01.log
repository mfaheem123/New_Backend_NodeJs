{"duration":112,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT COUNT(*) AS total\n    FROM zones z\n    ;\n  ","timestamp":"2026-04-01T09:05:06.487Z"}
{"duration":3,"level":"info","message":"db-query","rows":12,"text":"\n    SELECT \n      z.id,\n      z.name,\n      z.secondary_name,\n      z.type,\n      z.category,\n      z.vertices,\n      z.base,\n      z.overlay,\n      z.created_at,\n      z.updated_at\n    FROM zones z\n    \n    ORDER BY z.id ASC\n    LIMIT $1 OFFSET $2;\n  ","timestamp":"2026-04-01T09:05:06.490Z"}
{"level":"info","message":"GET /api/zones/get 304 116.601 ms","timestamp":"2026-04-01T09:05:06.491Z"}
{"duration":54,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      b.*,\n      vt.name as vehicle_type_name,\n      d.name as driver_name,\n      v.color,\n      v.make,\n      v.model,\n      v.vehicle_number\n    FROM bookings b\n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    LEFT JOIN drivers d ON b.driver_id = d.id\n    LEFT JOIN vehicles v ON d.vehicle_id = v.id\n    WHERE b.id = $1\n  ","timestamp":"2026-04-01T09:05:22.797Z"}
{"level":"info","message":"POST /api/bookings/assign-driver 400 56.469 ms","timestamp":"2026-04-01T09:05:22.799Z"}
