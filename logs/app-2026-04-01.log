{"duration":58,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT COUNT(*) AS total\n    FROM vehicle_types vt\n    ;\n  ","timestamp":"2026-04-01T09:04:26.943Z"}
{"duration":68,"level":"info","message":"db-query","rows":5,"text":"\n    SELECT fbv.*, row_to_json(vt) as vehicle_type\n    FROM fare_by_vehicles fbv\n    LEFT JOIN vehicle_types vt ON fbv.vehicle_type_id = vt.id\n    ORDER BY fbv.id ASC\n  ","timestamp":"2026-04-01T09:04:26.946Z"}
