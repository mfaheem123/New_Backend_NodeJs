{"duration":159,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.zone,\n      d.last_login_at,\n      \n      -- vehicle type name (dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN vt_cv.name\n        ELSE vt_v.name\n      END AS vehicle_type\n\n    FROM drivers d\n\n    -- company vehicle\n    LEFT JOIN company_vehicles cv \n      ON cv.id = d.company_vehicle_id\n\n    LEFT JOIN vehicle_types vt_cv \n      ON vt_cv.id = cv.vehicle_type_id\n\n    -- personal vehicle\n    LEFT JOIN vehicles v \n      ON v.id = d.vehicle_id\n\n    LEFT JOIN vehicle_types vt_v \n      ON vt_v.id = v.vehicle_type_id\n\n    WHERE \n      d.session_status = 'logged_in'\n      AND d.driver_status = 'Available'\n      AND d.booking_status = 'Available'\n  ","timestamp":"2026-04-01T07:25:15.279Z"}
{"duration":1,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.zone,\n      d.last_login_at,\n      \n      -- vehicle type name (dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN vt_cv.name\n        ELSE vt_v.name\n      END AS vehicle_type\n\n    FROM drivers d\n\n    -- company vehicle\n    LEFT JOIN company_vehicles cv \n      ON cv.id = d.company_vehicle_id\n\n    LEFT JOIN vehicle_types vt_cv \n      ON vt_cv.id = cv.vehicle_type_id\n\n    -- personal vehicle\n    LEFT JOIN vehicles v \n      ON v.id = d.vehicle_id\n\n    LEFT JOIN vehicle_types vt_v \n      ON vt_v.id = v.vehicle_type_id\n\n    WHERE \n      d.session_status = 'logged_in'\n      AND d.driver_status = 'Unavailable'\n      AND d.booking_status = 'Unavailable'\n  ","timestamp":"2026-04-01T07:25:15.281Z"}
