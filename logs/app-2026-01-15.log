{"duration":2,"level":"info","message":"db-query","rows":27,"text":"\n    SELECT \n      l.*, \n      jsonb_build_object(\n        'id', lt.id,\n        'name', lt.name,\n        'shortcut', lt.shortcut,\n        'background_color', lt.background_color,\n        'foreground_color', lt.foreground_color\n      ) AS location_type,\n      CASE WHEN z.id IS NOT NULL THEN\n        jsonb_build_object(\n          'id', z.id,\n          'name', z.name,\n          'secondary_name', z.secondary_name,\n          'type', z.type,\n          'category', z.category,\n          'vertices', z.vertices,\n          'base', z.base,\n          'overlay', z.overlay\n        )\n      ELSE NULL END AS zone\n    FROM locations l\n    LEFT JOIN location_types lt ON l.location_type_id = lt.id\n    LEFT JOIN zones z ON l.zone_id = z.id\n    \n    ORDER BY l.id ASC\n    LIMIT $1 OFFSET $2;\n  ","timestamp":"2026-01-15T18:26:18.165Z"}
