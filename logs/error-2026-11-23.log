{"duration":24,"level":"info","message":"db-query","rows":0,"text":"\n            SELECT \n                a.id, \n                a.type, \n                a.date, \n                a.time, \n                a.operation, \n                a.previous, \n                a.next, \n                a.employee_id, \n                a.booking_id, \n                a.driver_id,\n                json_build_object('username', e.username) AS employee,\n                CASE \n                    WHEN d.id IS NOT NULL THEN json_build_object(\n                        'username', d.username, \n                        'name', d.name, \n                        'mobile', d.mobile\n                    )\n                    ELSE NULL \n                END AS driver\n            FROM audits a\n            LEFT JOIN employees e ON a.employee_id = e.id\n            LEFT JOIN drivers d ON a.driver_id = d.id\n            WHERE a.booking_id = $1\n            ORDER BY a.date DESC, a.time DESC;\n        ","timestamp":"2026-11-23T17:37:39.427Z"}
