{"duration":4,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT id FROM public.customers \n    WHERE company_id = $1 AND (\n      (mobile IS NOT NULL AND mobile = $2) OR \n      (email IS NOT NULL AND email = $3)\n    )\n    LIMIT 1;\n  ","timestamp":"2026-10-19T16:14:42.807Z"}
{"duration":3,"level":"info","message":"db-query","rows":1,"text":"\n      UPDATE public.customers\n      SET \n        name = COALESCE($1, name),\n        email = COALESCE($2, email),\n        mobile = COALESCE($3, mobile),\n        telephone = COALESCE($4, telephone)\n      WHERE id = $5\n      RETURNING id;\n    ","timestamp":"2026-10-19T16:14:42.810Z"}
