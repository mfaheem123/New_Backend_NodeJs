 || ld.name || '%'\nLEFT JOIN location_types ltp ON lp.location_type_id = ltp.id\nLEFT JOIN location_types ltd ON ld.location_type_id = ltd.id\n\n\n\n  \n    WHERE DATE(b.pickup_date) > CURRENT_DATE AND b.trash = false\n    \n  \n  ORDER BY b.id ASC\n  OFFSET $1 LIMIT $2\n","timestamp":"2026-02-25T03:45:23.575Z"}
