{"duration":77,"level":"info","message":"db-query","rows":1,"text":"SELECT \n          b.pickup,\n          b.dropoff,\n          b.pickup_latitude,\n          b.pickup_longitude,\n          b.dropoff_latitude,\n          b.dropoff_longitude,\n          b.vehicle_type_id,\n          b.subsidiary_id,\n          b.employee_id,\n          c.name,\n          c.email,\n          c.mobile,\n          c.telephone\n        FROM bookings b\n        JOIN customers c ON b.customer_id = c.id\n        WHERE b.mobile = $1\n        ORDER BY b.id DESC\n        LIMIT 10","timestamp":"2026-02-25T02:40:48.516Z"}
