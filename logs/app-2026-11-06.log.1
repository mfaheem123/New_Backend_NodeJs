{"duration":19,"level":"info","message":"db-query","rows":1,"text":"\n      SELECT COUNT(*)\n      FROM account_invoices ai\n      LEFT JOIN accounts a ON ai.account_id = a.id\n      LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n      LEFT JOIN departments d ON ai.department_id = d.id\n      WHERE ai.company_id = $1\n    ","timestamp":"2026-11-06T16:56:09.166Z"}
{"duration":1,"level":"info","message":"db-query","rows":0,"text":"\n      SELECT \n        ai.*,\n\n        json_build_object(\n          'name', a.name,\n          'email', a.email,\n          'subsidiary_id', a.subsidiary_id,\n\n          'subsidiary',\n          json_build_object(\n            'id', s.id,\n            'name', s.name\n          )\n        ) as account,\n\n        CASE \n          WHEN d.id IS NOT NULL THEN \n            json_build_object(\n              'id', d.id,\n              'name', d.name\n            )\n          ELSE NULL\n        END as department\n\n      FROM account_invoices ai\n      LEFT JOIN accounts a ON ai.account_id = a.id\n      LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n      LEFT JOIN departments d ON ai.department_id = d.id\n\n      WHERE ai.company_id = $1\n      ORDER BY ai.id DESC\n      OFFSET $2\n      LIMIT $3\n    ","timestamp":"2026-11-06T16:56:09.168Z"}
