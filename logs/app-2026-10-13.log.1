{"duration":17,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT \n      b.*,\n      vt.name as vehicle_type_name,\n      d.name as driver_name,\n      v.color,\n      v.make,\n      v.model,\n      v.vehicle_number\n    FROM bookings b\n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    LEFT JOIN drivers d ON b.driver_id = d.id\n    LEFT JOIN vehicles v ON d.vehicle_id = v.id\n    WHERE b.id = $1 AND trash = false\n  ","timestamp":"2026-10-13T16:51:10.107Z"}
{"duration":2,"level":"info","message":"db-query","rows":1,"text":"\n    UPDATE drivers\n    SET \n      booking_status = $1,\n      driver_status = $2\n    WHERE id = $3\n  ","timestamp":"2026-10-13T16:51:10.110Z"}
{"duration":1,"level":"info","message":"db-query","rows":1,"text":"\n    UPDATE drivers\n    SET \n      last_booking = $1\n    WHERE id = $2\n  ","timestamp":"2026-10-13T16:51:10.112Z"}
{"duration":23,"level":"info","message":"db-query","rows":1,"text":"SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.zone,\n      d.latitude,\n      d.longitude,\n      d.booking_status,\n      d.session_status,\n      d.driver_status,\n      d.last_login_at,\n      d.has_pda,\n      \n      -- Vehicle Type (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN vt_cv.name\n        ELSE vt_v.name\n      END AS vehicle_type,\n\n      -- Vehicle Number (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.vehicle_number\n        ELSE v.vehicle_number\n      END AS vehicle_no,\n\n      -- Vehicle Make (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.make\n        ELSE v.make\n      END AS make,\n\n      -- Vehicle Model (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.model\n        ELSE v.model\n      END AS model,\n\n      -- Vehicle Color (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.color\n        ELSE v.color\n      END AS color\n\n    FROM drivers d\n\n    -- Company vehicle joins\n    LEFT JOIN company_vehicles cv \n      ON cv.id = d.company_vehicle_id\n\n    LEFT JOIN vehicle_types vt_cv \n      ON vt_cv.id = cv.vehicle_type_id\n\n    -- Personal vehicle joins\n    LEFT JOIN vehicles v \n      ON v.id = d.vehicle_id\n\n    LEFT JOIN vehicle_types vt_v \n      ON vt_v.id = v.vehicle_type_id\n      WHERE d.id = $1","timestamp":"2026-10-13T16:51:10.136Z"}
{"driverId":167,"level":"info","message":"ws:booking-status-broadcast","timestamp":"2026-10-13T16:51:10.138Z"}
{"duration":2,"level":"info","message":"db-query","rows":1,"text":"\n      SELECT \n      d.id,\n      d.name,\n      d.username,\n      d.zone,\n      d.latitude,\n      d.longitude,\n      d.booking_status,\n      d.session_status,\n      d.driver_status,\n      d.last_login_at,\n      d.has_pda,\n      d.company_id,\n      \n      -- Vehicle Type (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN vt_cv.name\n        ELSE vt_v.name\n      END AS vehicle_type,\n\n      -- Vehicle Number (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.vehicle_number\n        ELSE v.vehicle_number\n      END AS vehicle_no,\n\n      -- Vehicle Make (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.make\n        ELSE v.make\n      END AS make,\n\n      -- Vehicle Model (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.model\n        ELSE v.model\n      END AS model,\n\n      -- Vehicle Color (Dynamic)\n      CASE \n        WHEN d.use_company_vehicle = true THEN cv.color\n        ELSE v.color\n      END AS color\n\n    FROM drivers d\n\n    -- Company vehicle joins\n    LEFT JOIN company_vehicles cv \n      ON cv.id = d.company_vehicle_id\n\n    LEFT JOIN vehicle_types vt_cv \n      ON vt_cv.id = cv.vehicle_type_id\n\n    -- Personal vehicle joins\n    LEFT JOIN vehicles v \n      ON v.id = d.vehicle_id\n\n    LEFT JOIN vehicle_types vt_v \n      ON vt_v.id = v.vehicle_type_id\n      WHERE d.id=$1\n      ","timestamp":"2026-10-13T16:51:10.141Z"}
