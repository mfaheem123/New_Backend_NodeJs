{"duration":64,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      COUNT(*) AS total_bookings,\n\n      ROUND(\n        COALESCE(\n          SUM(\n            COALESCE(b.fares, 0)\n            + COALESCE(b.parking_charges, 0)\n            + COALESCE(b.waiting_charges, 0)\n            + COALESCE(b.extra_drop_charges, 0)\n          ),\n          0\n        )::numeric,\n        2\n      ) AS total_earnings\n\n    FROM bookings b\n    \n    WHERE b.trash = false AND b.booking_status_id = 11 AND b.pickup_date >= $1 AND b.pickup_date <= $2 AND b.driver_id = $3\n  \n  ","timestamp":"2026-06-01T12:29:55.714Z"}
