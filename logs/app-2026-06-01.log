n_type_id = 2\n AND b.dropoff ILIKE '%' || ld.name || '%'\nLEFT JOIN location_types ltp ON lp.location_type_id = ltp.id\nLEFT JOIN location_types ltd ON ld.location_type_id = ltd.id\n\n\n\n  \n    WHERE b.trash = false AND b.pickup_date >= $1 AND b.pickup_date <= $2 AND TRIM(b.pickup_time)::time >= $3::time AND TRIM(b.pickup_time)::time <= $4::time\n  \n  ORDER BY (b.pickup_date::date + TRIM(b.pickup_time)::time) ASC\n  OFFSET $5\n  LIMIT $6\n","timestamp":"2026-06-01T13:19:38.027Z"}
