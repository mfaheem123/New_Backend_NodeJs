{"duration":191,"level":"info","message":"db-query","rows":4,"text":"\n  SELECT\n    TO_CHAR(b.pickup_date::date, 'YYYY-MM-DD') AS date,\n\n    pt.name AS payment_type,\n\n    COUNT(b.id) AS total_bookings,\n\n    COALESCE(SUM(b.fares), 0) AS total_fares\n\n  FROM bookings b\n\n  LEFT JOIN payment_types pt\n    ON pt.id = b.payment_type_id\n\n  \n    WHERE b.trash = false AND b.pickup_date >= $1 AND b.pickup_date <= $2 AND b.booking_status_id = $3\n  \n\n  GROUP BY\n    b.pickup_date::date,\n    pt.name\n\n  ORDER BY\n    b.pickup_date::date ASC\n","timestamp":"2026-08-17T17:04:45.597Z"}
