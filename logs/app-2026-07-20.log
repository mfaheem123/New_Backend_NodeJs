{"duration":49,"level":"info","message":"db-query","rows":15,"text":"SELECT * FROM booking_statuses ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.126Z"}
{"duration":2,"level":"info","message":"db-query","rows":2,"text":"SELECT * FROM booking_types ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.128Z"}
{"duration":3,"level":"info","message":"db-query","rows":3,"text":"SELECT * FROM journey_types ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.132Z"}
{"duration":6,"level":"info","message":"db-query","rows":3,"text":"SELECT * FROM payment_statuses ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.138Z"}
{"duration":3,"level":"info","message":"db-query","rows":4,"text":"SELECT * FROM payment_types ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.141Z"}
{"duration":4,"level":"info","message":"db-query","rows":0,"text":"SELECT * FROM vehicle_types WHERE company_id = $1 ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.145Z"}
{"duration":8,"level":"info","message":"db-query","rows":0,"text":"SELECT id, background_color, foreground_color, name FROM subsidiaries WHERE company_id = $1 ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.153Z"}
{"duration":12,"level":"info","message":"db-query","rows":0,"text":"\n        SELECT \n          d.id,\n          d.name AS username,\n          d.username AS name,\n          d.zone,\n          d.last_login_at,\n          \n          -- vehicle type name (dynamic)\n          CASE \n            WHEN d.use_company_vehicle = true THEN vt_cv.name\n            ELSE vt_v.name\n          END AS vehicle_type\n    \n        FROM drivers d\n    \n        -- company vehicle\n        LEFT JOIN company_vehicles cv \n          ON cv.id = d.company_vehicle_id\n    \n        LEFT JOIN vehicle_types vt_cv \n          ON vt_cv.id = cv.vehicle_type_id\n    \n        -- personal vehicle\n        LEFT JOIN vehicles v \n          ON v.id = d.vehicle_id\n    \n        LEFT JOIN vehicle_types vt_v \n          ON vt_v.id = v.vehicle_type_id\n    \n        WHERE \n          d.session_status = 'logged_in'\n          AND d.driver_status = 'Available'\n          AND d.booking_status = 'Available'\n          AND d.company_id = $1\n      ","timestamp":"2026-07-20T12:46:11.165Z"}
{"duration":14,"level":"info","message":"db-query","rows":8,"text":"\n      SELECT\n        bt.id,\n        bt.booking_tabs,\n        CASE bt.id\n          WHEN 1 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) = CURRENT_DATE \n            AND booking_status_id = 1 \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 2 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE DATE(pickup_date) > CURRENT_DATE \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 3 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id != 11 \n            AND booking_status_id != 1 \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 4 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_status_id = 11 \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 5 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE quoted = true \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 6 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'ivr' \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 7 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'web' \n            AND trash = false\n            AND company_id = $1\n          )\n          WHEN 8 THEN (\n            SELECT COUNT(*) FROM bookings \n            WHERE booking_source = 'app' \n            AND trash = false\n            AND company_id = $1\n          )\n        END::int AS booking_count\n      FROM booking_tabs bt\n      ORDER BY bt.id ASC\n    ","timestamp":"2026-07-20T12:46:11.180Z"}
{"duration":4,"level":"info","message":"db-query","rows":0,"text":"SELECT \n      f.*, \n      vt.name AS vehicle_type_name, \n      vt.minimum_fares AS vehicle_minimum_fare\n        FROM fare_configurations f\n          LEFT JOIN vehicle_types vt ON vt.id = f.vehicle_type_id\n          WHERE f.company_id = $1\n        ORDER BY id ASC","timestamp":"2026-07-20T12:46:11.185Z"}
{"duration":5,"level":"info","message":"db-query","rows":0,"text":"SELECT \n    f.*,\n    vt.name AS vehicle_type_name,\n    lf.name AS from_location_name,\n    lt.name AS to_location_name\n      FROM fixed_fares f\n        JOIN vehicle_types vt \n          ON f.vehicle_type_id = vt.id\n        JOIN location_types lf \n           ON f.from_location_id = lf.id\n        JOIN location_types lt \n          ON f.to_location_id = lt.id\n          WHERE f.company_id = $1\n      ORDER BY f.id ASC","timestamp":"2026-07-20T12:46:11.191Z"}
{"duration":11,"level":"info","message":"db-query","rows":0,"text":"SELECT \n        pf.*, \n        vt.name AS vehicle_type_name,\n        p1.id AS pickup_plot_id, p1.name AS pickup_plot_name,\n        p2.id AS dropoff_plot_id, p2.name AS dropoff_plot_name\n      FROM plot_fares pf\n      JOIN vehicle_types vt ON vt.id = pf.vehicle_type_id\n      JOIN zones p1 ON p1.id = pf.pickup_plot_id\n      JOIN zones p2 ON p2.id = pf.dropoff_plot_id\n      WHERE pf.company_id = $1\n      ORDER BY pf.id ASC","timestamp":"2026-07-20T12:46:11.202Z"}
{"duration":3,"level":"info","message":"db-query","rows":0,"text":" SELECT fbv.*, row_to_json(vt) as vehicle_type\n    FROM fare_by_vehicles fbv\n    LEFT JOIN vehicle_types vt ON fbv.vehicle_type_id = vt.id\n    WHERE fbv.company_id = $1\n    ORDER BY fbv.id ASC","timestamp":"2026-07-20T12:46:11.205Z"}
{"duration":3,"level":"info","message":"db-query","rows":0,"text":" SELECT l.*,\n                   to_json(lt) AS location_type\n            FROM locations l\n            LEFT JOIN location_types lt\n              ON lt.id = l.location_type_id\n            WHERE l.location_type_id = 2 AND l.company_id = $1\n            ORDER BY l.id ASC","timestamp":"2026-07-20T12:46:11.208Z"}
{"level":"info","message":"GET /api/enumerations/get?company_id=3 200 132.131 ms","timestamp":"2026-07-20T12:46:11.209Z"}
