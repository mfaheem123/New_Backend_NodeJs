n_type_id = 2\n AND b.dropoff ILIKE '%' || ld.name || '%'\nLEFT JOIN location_types ltp ON lp.location_type_id = ltp.id\nLEFT JOIN location_types ltd ON ld.location_type_id = ltd.id\n\n\n\n  \n    WHERE b.trash = false AND b.pickup_date >= $1 AND b.pickup_date <= $2 AND TRIM(b.pickup_time)::time >= $3::time AND TRIM(b.pickup_time)::time <= $4::time AND b.payment_type_id = $5 AND b.driver_id = $6\n  \n  ORDER BY b.reference_number ASC\n  OFFSET $7\n  LIMIT $8\n","timestamp":"2026-07-20T17:11:26.621Z"}
