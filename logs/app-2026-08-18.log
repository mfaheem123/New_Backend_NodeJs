L (\n  SELECT l.*\n  FROM locations l\n  WHERE l.location_type_id = 2\n    AND b.pickup ILIKE '%' || l.name || '%'\n  ORDER BY LENGTH(l.name) DESC, l.id ASC\n  LIMIT 1\n) lp ON true\n\n\n-- DROPOFF LOCATION\n-- Select only the most specific matching location\nLEFT JOIN LATERAL (\n  SELECT l.*\n  FROM locations l\n  WHERE l.location_type_id = 2\n    AND b.dropoff ILIKE '%' || l.name || '%'\n  ORDER BY LENGTH(l.name) DESC, l.id ASC\n  LIMIT 1\n) ld ON true\n\n\nLEFT JOIN location_types ltp\n  ON lp.location_type_id = ltp.id\n\nLEFT JOIN location_types ltd\n  ON ld.location_type_id = ltd.id\n\n\n    \n    WHERE b.trash = false AND \n      TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n      >= TO_DATE($1, 'YYYY-MM-DD')\n     AND \n      TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD')\n      <= TO_DATE($2, 'YYYY-MM-DD')\n     AND TRIM(b.pickup_time)::time >= $3::time AND TRIM(b.pickup_time)::time <= $4::time AND b.booking_status_id = ANY($5::int[]) AND b.payment_type_id = ANY($6::int[]) AND b.driver_id = $7 AND b.pickup ILIKE $8 AND b.invoice_number ILIKE $9 AND a.name ILIKE $10 AND pt.name ILIKE $11 AND bs.booking_status ILIKE $12 AND jt.journey_type ILIKE $13 AND vt.name ILIKE $14 AND b.fares::text ILIKE $15\n  \n    ORDER BY (\n        TO_DATE(b.pickup_date,'YYYY-FMMM-FMDD')\n        +\n        TRIM(b.pickup_time)::time\n      ) ASC\n    OFFSET $16\n    LIMIT $17\n  ","timestamp":"2026-08-18T18:13:41.910Z"}
