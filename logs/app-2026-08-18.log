{"duration":56,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      COUNT(*) AS total_bookings,\n\n      ROUND(\n        COALESCE(\n          SUM(\n            COALESCE(b.fares, 0)\n            + COALESCE(b.parking_charges, 0)\n            + COALESCE(b.waiting_charges, 0)\n            + COALESCE(b.extra_drop_charges, 0)\n          ),\n          0\n        )::numeric,\n        2\n      ) AS total_earnings\n\n    FROM bookings b\n    \n    WHERE b.trash = false AND b.booking_status_id = 11 AND TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD') >= TO_DATE($1, 'YYYY-MM-DD') AND TO_DATE(b.pickup_date, 'YYYY-FMMM-FMDD') <= TO_DATE($2, 'YYYY-MM-DD') AND b.driver_id = $3\n  \n  ","timestamp":"2026-08-18T18:31:53.203Z"}
