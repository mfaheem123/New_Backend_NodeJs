{"level":"info","message":"GET /api/zones/get 200 155.696 ms","timestamp":"2026-02-17T11:41:02.516Z"}
{"duration":26,"level":"info","message":"db-query","rows":11,"text":"\n    SELECT \n      z.id,\n      z.name,\n      z.secondary_name,\n      z.type,\n      z.category,\n      z.vertices,\n      z.base,\n      z.overlay,\n      z.created_at,\n      z.updated_at\n    FROM zones z\n    \n    ORDER BY z.id ASC\n    LIMIT $1 OFFSET $2;\n  ","timestamp":"2026-02-17T11:41:02.520Z"}
