{"duration":3,"level":"info","message":"db-query","rows":7,"text":"\n      SELECT \n        ai.*,\n\n        json_build_object(\n          'name', a.name,\n          'email', a.email,\n          'subsidiary_id', a.subsidiary_id,\n\n          'subsidiary',\n          json_build_object(\n            'id', s.id,\n            'name', s.name\n          )\n        ) as account,\n\n        CASE \n          WHEN d.id IS NOT NULL THEN \n            json_build_object(\n              'id', d.id,\n              'name', d.name\n            )\n          ELSE NULL\n        END as department\n\n      FROM account_invoices ai\n      LEFT JOIN accounts a ON ai.account_id = a.id\n      LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n      LEFT JOIN departments d ON ai.department_id = d.id\n\n      \n      ORDER BY ai.id DESC\n      OFFSET $1\n      LIMIT $2\n    ","timestamp":"2026-04-07T07:18:46.822Z"}
