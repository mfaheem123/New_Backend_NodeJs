{"duration":6,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT COUNT(*) AS total\n    FROM bookings b\n    LEFT JOIN booking_statuses bs ON b.booking_status_id = bs.id\n    LEFT JOIN journey_types jt ON b.journey_type_id = jt.id\n    LEFT JOIN payment_types pt ON b.payment_type_id = pt.id\n    LEFT JOIN accounts a ON b.account_id = a.id\n    LEFT JOIN drivers d ON b.driver_id = d.id\n    LEFT JOIN vehicle_types vt ON b.vehicle_type_id = vt.id\n    \n    WHERE \n          DATE(b.pickup_date) = CURRENT_DATE\n          AND b.booking_status_id = 1 AND b.trash = false\n        \n    \n  \n  ","timestamp":"2026-04-23T15:24:11.110Z"}
{"duration":16,"level":"info","message":"db-query","rows":1,"text":"\n    SELECT\n      a.id,a.subsidiary_id,a.account_type,a.name,a.email,a.mobile,a.payment_types,a.information,a.background_color,a.foreground_color,\n      json_agg(DISTINCT jsonb_build_object('id', d.id, 'name', d.name)) AS departments,\n      jsonb_build_object(\n        'id', s.id,\n        'name', s.name,\n        'telephone_number', s.telephone_number,\n        'email', s.email\n      ) AS subsidiary\n    FROM accounts a\n    LEFT JOIN departments d ON a.id = d.account_id\n    LEFT JOIN subsidiaries s ON a.subsidiary_id = s.id\n    WHERE a.subsidiary_id = $1\n    GROUP BY a.id, s.id\n    ORDER BY a.id ASC;\n  ","timestamp":"2026-04-23T15:24:11.121Z"}
