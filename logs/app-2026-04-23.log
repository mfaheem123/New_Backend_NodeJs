{"duration":6,"level":"info","message":"db-query","rows":1,"text":"\n      SELECT ee.*, \n        json_build_object(\n          'id', e.id,\n          'username', e.username\n        ) AS employee\n      FROM employee_extensions ee\n      LEFT JOIN employees e ON e.id = ee.employee_id\n      WHERE ee.employee_id = $1\n    ","timestamp":"2026-04-23T15:24:02.097Z"}
