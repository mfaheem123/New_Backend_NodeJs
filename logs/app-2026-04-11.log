{"duration":87,"level":"info","message":"db-query","rows":1,"text":"SELECT \n        t.id,\n        t.template_type_id,\n        t.name,\n        t.subject,\n        t.content,\n        t.body,\n        tt.id as template_type_id,\n        tt.name as template_type_name\n       FROM templates t\n       JOIN template_types tt ON t.template_type_id = tt.id\n       WHERE t.id = $1","timestamp":"2026-04-11T09:56:21.375Z"}
